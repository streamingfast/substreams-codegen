mod pb;

use crate::pb::sf::tron::r#type::v1::Block;
use pb::mydata::v1 as mydata;
use substreams::Hex;

#[substreams::handlers::map]
fn map_my_data(blk: Block) -> mydata::MyData {
    let header = blk.header.unwrap();

    let mut my_data = mydata::MyData::default();
    my_data.hash = Hex(blk.id).to_string();
    my_data.number = header.number;
    my_data.transactions_len = blk.transactions.len() as u64;
    my_data
}
