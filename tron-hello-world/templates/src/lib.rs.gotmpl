#[allow(unused)]
mod pb;

use crate::pb::{
    mydata::v1::{MyData, TransferContract},
    protocol::{transaction::contract::ContractType, TransferContract as TransferContractProto},
    sf::tron::r#type::v1::Block,
};
use pb::mydata::v1 as mydata;
use buffa_types::Timestamp;
use sha2::{Digest, Sha256};

#[substreams::handlers::map]
fn map_my_data(block: Block) -> Result<mydata::MyData, substreams::errors::Error> {
    let contracts: Vec<TransferContract> = block
        .transactions
        .into_iter()
        .flat_map(|transaction| {
            transaction
                .contracts
                .into_iter()
                // If you only want the Transactions, you should use the foundational module
                // as your input instead of the full block. This allows the use of an index
                // to go through the chain faster, try it using the tron-transactions codegen.
                .filter(|contract| contract.r#type == buffa::EnumValue::Known(ContractType::TransferContract))
                .filter(|contract| {
                    if let Some(parameter) = contract.parameter.as_option() {
                        // Decode the `parameter` field, which is a protobuf.Any object
                        if let Ok(decoded) = parameter.unpack_unchecked::<TransferContractProto>() {
                            return decoded.amount > 100_000_000;
                        }
                    }
                    return false;
                })
                .map(|contract| {
                    let decoded = contract
                        .parameter
                        .as_option()
                        .unwrap()
                        .unpack_unchecked::<TransferContractProto>()
                        .unwrap();
                    return TransferContract {
                        owner: tron_address_to_base58(&decoded.owner_address),
                        to: tron_address_to_base58(&decoded.to_address),
                        amount: decoded.amount,
                        permissions_id: contract.permission_id as u32,
                    };
                })
        })
        .collect();

    let header = block.header.as_option().unwrap();
    let timestamp_millis = header.timestamp;

    Ok(MyData {
        block_number: header.number as u64,
        timestamp: buffa::MessageField::some(Timestamp {
            seconds: timestamp_millis / 1000,
            nanos: ((timestamp_millis % 1000) * 1_000_000) as i32,
            ..Default::default()
        }),
        transfer_contracts: contracts,
    })
}

/// Converts Tron address bytes to a Base58Check-encoded string (with checksum).
/// The address bytes must already include the Tron prefix (0x41).
pub fn tron_address_to_base58(address: &[u8]) -> String {
    let hash1 = Sha256::digest(address);
    let hash2 = Sha256::digest(&hash1);
    let checksum = &hash2[0..4];
    let mut payload = address.to_vec();
    payload.extend_from_slice(checksum);
    bs58::encode(payload).into_string()
}
