syntax = "proto3";

package mydata.v1;

import "sf/tron/type/v1/block.proto";
import "google/protobuf/any.proto";

message MyData {
  repeated TransferContract transfer_contracts = 1;
}

message TransferContract {
  bytes contract_name = 1;
  google.protobuf.Any parameter = 2;
  bytes provider = 3;
  uint32 permissions_id = 4;
}