specVersion: v0.1.0
package:
  name: {{ .GetModuleName }}
  version: v0.1.0

imports:
  stellar: stellar-foundational@v0.5.0

protobuf:
  excludePaths:
    - sf/substreams
    - google

binaries:
  default:
    type: wasm/rust-v1
    file: ./target/wasm32-unknown-unknown/release/substreams.wasm

modules:
{{ if eq .FilterType "transactions" }}
 - name: map_my_filtered_transactions
   use: stellar:filtered_transactions

 - name: map_my_data
   kind: map
   initialBlock: {{ if eq .GetChainNetwork "stellar" }}55411000{{ else }}767{{ end }}
   inputs:
   - map: map_my_filtered_transactions
   output:
    type: proto:sf.substreams.stellar.type.v1.Transactions
{{ else }}
 - name: map_my_filtered_operations
   use: stellar:filtered_operations

 - name: map_my_data
   kind: map
   initialBlock: 55411000
   inputs:
   - map: map_my_filtered_operations
   output:
    type: proto:sf.substreams.stellar.type.v1.Operations
{{ end }}

network: {{ .GetChainNetwork }}

params:
  {{ if eq .FilterType "transactions" }}map_my_filtered_transactions{{ else }}map_my_filtered_operations{{ end }}: {{ .ComposeFilter }}
