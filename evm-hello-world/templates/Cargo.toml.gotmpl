[package]
name = "{{ .Name }}"
version = "0.0.1"
edition = "2021"

[lib]
name = "substreams"
crate-type = ["cdylib"]

[dependencies]
buffa = "0.9.2"
buffa-types = "0.9.2"
hex-literal = "0.3.4"
num-bigint = "0.4"
num-traits = "0.2.15"
substreams = "0.8.0"
substreams-ethereum = "0.12.0"

[build-dependencies]
anyhow = "1"
substreams-ethereum = "0.12.0"
regex = "1.8"

[profile.release]
lto = true
opt-level = 's'
strip = "debuginfo"
