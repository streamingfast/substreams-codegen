syntax = "proto3";

package substreams.v1.program;

message Data {
  {{- $counter := 0 }}
  {{- range $i, $event := .Idl.Events }}
    {{- $counter = add $counter 1 }}
    repeated {{ $event.Name }}Event {{ $event.SnakeCaseName }}_event_list = {{ $counter }};
  {{- end}}

  {{- range $i, $instruction := .Idl.Instructions -}}
    {{- $counter = add $counter 1 }}
    repeated {{ $instruction.PascalCaseName }}Instruction {{ $instruction.SnakeCaseName }}_instruction_list = {{ $counter }};
  {{- end }}
}

{{- range $i, $event := .Idl.Events }}
{{- $counter := 1 }}
message {{$event.Name}}Event {
    {{- range $i, $arg := $event.Fields }}
        {{- $counter = add $counter 1 }}
        {{ $arg.Type.GetResolvedFieldType.ResolveProtobufType }} {{ $arg.SnakeCaseName }} = {{ $counter }};
    {{- end }}
}
{{ end }}

{{- range $i, $inst := .Idl.Instructions }}
{{- $counter := 1 }}
message {{$inst.PascalCaseName}}Instruction {
    {{- range $i, $arg := $inst.Args }}
        {{- $counter = add $counter 1 }}
        {{ $arg.Type.GetResolvedFieldType.ResolveProtobufType }} {{ $arg.SnakeCaseName }} = {{ $counter }};
    {{- end }}
}
{{ end }}

{{ range $i, $type := .Idl.AccountsAndTypes }}
{{- if $type.Type.IsStruct }}
{{- $structCounter := 1 }}
message {{$type.Name}} {
{{- range $i, $field := $type.Type.Struct.Fields }}
    {{ $field.Type.GetResolvedFieldType.ResolveProtobufType }} {{ $field.SnakeCaseName }} = {{ $structCounter }};
    {{- $structCounter = add $structCounter 1 }}
{{- end}}
}
{{- else if $type.Type.IsEnum }}
// Enum
{{- $variantCounter := 1 }}
message {{ $type.Name }} {
  oneof kind {
    {{- range $i, $variant := $type.Type.Enum.Variants }}
      {{ $type.Name }}{{ $variant.Name }}Variant {{ $variant.SnakeCaseName }} = {{ $variantCounter }};
      {{- $variantCounter = add $variantCounter 1 }}
    {{- end}}
  }
}

{{- range $i, $variant := $type.Type.Enum.Variants }}
message {{ $type.Name }}{{ $variant.Name }}Variant {
  {{- $fieldCounter := 1 }}
  {{- range $i, $field := $variant.Fields }}
    {{ $field.Type.GetResolvedFieldType.ResolveProtobufType }} {{ $field.SnakeCaseName }} = {{ $fieldCounter }};
    {{- $fieldCounter = add $fieldCounter 1 }}
  {{- end}}
}
{{- end}}
{{- end }}
{{- end }}

message PubKey {
  string key = 1;
}

{{ $.Idl.PrintNecessaryProtobufMessages }}
