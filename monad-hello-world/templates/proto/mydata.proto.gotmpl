syntax = "proto3";

package mydata.v1;

// MyData represents the data that you map out from a Monad block to your own needs.
// You can structure it however you want, this is controlled by you, so adjust
// based on your needs.
//
// In this example, we define a MyData message that contains a list of transactions,
// and each transaction contains its hash, from address, to address, value, and a list of
// logs (events) emitted during execution.
message MyData {
  repeated Transaction transactions = 1;
}

message Transaction {
  string transaction_hash = 1;
  string from_address = 2;
  string to_address = 3;
  string value = 4; // Transaction value in wei (as string to handle large numbers)
  uint64 gas_used = 5;
  repeated Log logs = 6;
}

message Log {
  string contract_address = 1;
  repeated string topics = 2;
  bytes data = 3;
}
